# Python build output
python/dist/
__pycache__/

*.log
.DS_Store

# Probe run artifacts (color_cycle dig/effects reports, known-pattern lists)
dig_probe_*.json
effect_probe_*.json
known_patterns.txt

# annotate_captures run logs
annotations_*.jsonl

# replay validation run artifacts (recorder logs, rx captures, reports,
